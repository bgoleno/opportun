# Settings for the Docker Compose deployment. Copy this file to deploy/.env (compose reads
# .env from the directory holding compose.yml) and edit it. Never commit the copy.
#
# The master key is not set here: compose reads it from deploy/data/master.key
# (OPPORTUN_MASTER_KEY_FILE). Create it once with:
#   (umask 077; openssl rand -hex 32 > deploy/data/master.key)
# Losing it makes stored secrets (AI keys, OAuth tokens) unreadable.

# Uncomment and set this before anything else (issue #203). A compose project name is a
# global namespace on the Docker host: every container, network and named volume this
# deployment creates is reachable, by that name alone, from any other checkout or directory
# on the same machine, with no flag required. Left commented out, compose.yml's own fallback
# name is used instead, deliberately one no real deployment would choose, so the deployment
# still comes up and works, just without a name of its own: a test run elsewhere lands on
# nothing that matters rather than on this one either way, but setting it here is what makes
# this *your* deployment under *your* name, and lets you tell its containers and volumes
# apart from anyone else's in `docker ps` / `docker volume ls`.
# If this deployment already exists and was never given this setting, it is already running
# under compose.yml's old literal name (`opportun`, before this file started recommending
# otherwise): set COMPOSE_PROJECT_NAME=opportun here, matching that, rather than picking a
# new value, or the next `docker compose up` creates a second, empty stack beside the real
# one instead of recognizing it.
# COMPOSE_PROJECT_NAME=opportun

# Run the published image instead of building from this checkout. Unset (the default),
# `docker compose up -d --build` builds locally and tags the result opportun:local. Set, compose
# pulls this image and builds nothing; start with `docker compose up -d`, without --build.
# Public, no login needed, linux/amd64 only. `latest` follows main; pin a `sha-...` tag to
# upgrade only when you choose.
# OPPORTUN_IMAGE=ghcr.io/bgoleno/opportun:latest

# The URL people open. Cookies are marked Secure and OAuth callbacks are built from it.
# Local use: http://localhost:8080. With a domain: https://jobs.example.com
OPPORTUN_BASE_URL=http://localhost:8080

# Set to your domain (jobs.example.com, no scheme) for automatic HTTPS via Caddy.
# Leave empty for plain HTTP on localhost.
OPPORTUN_DOMAIN=

# Which addresses Caddy answers on. 0.0.0.0 means every network interface of this machine,
# so a phone, a tablet or another person's computer on the same network can reach Opportun
# at http://<this-machine>:8080. That is the normal setup for a household, and it is the
# default (ADR-14).
# Set 127.0.0.1 to restrict it to the machine it runs on, and nothing else.
# Worth knowing before you leave the default: on a laptop that joins other networks, the
# login page becomes visible on those networks too. An account and password are still
# required, so what is exposed is that Opportun is running, not what is in it.
# Exposing it to the internet needs a domain as well: see docs/install.md section 3.
OPPORTUN_BIND_ADDRESS=0.0.0.0
OPPORTUN_HTTP_PORT=8080
OPPORTUN_HTTPS_PORT=443

# Interface the server process listens on when run directly (not in Docker: the image
# sets 0.0.0.0 inside the container and Caddy fronts it). Default 127.0.0.1 (local only).
# Set 0.0.0.0, or a specific interface IP such as your Tailscale address, to expose the
# server deliberately, ideally behind the Caddy proxy for HTTPS.
# OPPORTUN_HOST=127.0.0.1

# Trusted reverse proxies (issue #333). The app honours X-Forwarded-For and X-Forwarded-Proto
# ONLY from the addresses listed here, comma-separated (IPs, CIDR ranges, or loopback/linklocal/
# uniquelocal); every other peer is taken at its real socket address. Empty by default (trust
# nothing), which is correct for a from-source or bare-metal install reached directly: it stops
# a LAN client from spoofing its address past the per-IP rate limits. The Docker Compose
# deployment sets this automatically from OPPORTUN_COMPOSE_SUBNET below, since Caddy is the proxy
# there, so you only set this by hand when running behind your own proxy.
# OPPORTUN_TRUSTED_PROXIES=

# The pinned subnet for the Compose network. Both the network definition and the app's trusted-
# proxy list read it, so the app trusts Caddy and no guesswork is needed. Change it only if this
# range collides with another network on the host (docker compose up reports the collision);
# keep it inside a private range.
# OPPORTUN_COMPOSE_SUBNET=172.31.242.0/24

# pino log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Database engine: sqlite (the default: opportun.db on its own named volume, nothing else
# to set) or postgres (beta; docs/install.md section 15, including moving existing data
# with the copy tool). A single user needs nothing but SQLite. DATA_DIR stays required
# either way: attachments, backups, exports and master.key live on disk.
# DB_DIALECT=sqlite

# --- Postgres (only with DB_DIALECT=postgres) ---
# This file then holds a password: chmod 600 deploy/.env (docs/install.md section 15).
# Compose: COMPOSE_PROFILES=postgres starts the bundled postgres:16 service (host `db`,
# database and user `opportun`, C collation), whose password is POSTGRES_PASSWORD
# (generate one: openssl rand -hex 24). Use the same password in DATABASE_URL.
# COMPOSE_PROFILES=postgres
# POSTGRES_PASSWORD=
# The URL holds the password and is never logged. Outside compose prefer DATABASE_URL_FILE
# (a file containing the URL). The database must use C collation (docs/install.md).
# DATABASE_URL=postgres://opportun:<POSTGRES_PASSWORD>@db:5432/opportun
# DATABASE_URL_FILE=/run/secrets/database_url
# Connection pool size (default 10).
# DB_POOL_MAX=10
# TLS: disable, require or verify-full. Default: disable for localhost or a unix socket,
# require otherwise (so the compose host `db` defaults to require). sslmode in the URL is
# honored when DB_SSL is unset. The bundled postgres:16 service has no TLS on the compose
# network: set DB_SSL=disable with it. Use require or verify-full for a managed or remote
# database.
# DB_SSL=disable

# How many background jobs run at once (default 4, minimum 1). Jobs run in parallel so a
# long sync cannot hold up something you asked for, such as an import. Lower it on a small
# machine; 1 restores the old one-at-a-time behaviour. A few kinds stay capped at one
# regardless (Gmail sync, backup), where parallelism would only duplicate work.
#OPPORTUN_JOB_WORKERS=4
