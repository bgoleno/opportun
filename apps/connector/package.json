{
  "name": "@opportun/connector",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Apple Mail connector for Opportun: reads mail on your Mac and pushes it to your server with a device token.",
  "type": "module",
  "bin": {
    "opportun-connector": "./dist/opportun-connector.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && chmod 755 dist/opportun-connector.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@opportun/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
