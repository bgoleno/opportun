# Settings for the public demo deployment (issue #290). Copy this file to the demo host's own
# .env, outside this repository (the demo host never has a checkout; see
# docs/demo-deployment.md for why and how it runs), fill in every blank value below, then run:
#
#   docker compose -f deploy/compose.yml -f deploy/compose.demo.yml --env-file .env up -d
#
# On a host that already runs its own reverse proxy on :443, add the third override so the
# bundled Caddy stays out of the way (docs/demo-deployment.md, "If the host already runs its own
# proxy on :443"):
#
#   docker compose -f deploy/compose.yml -f deploy/compose.demo.yml \
#     -f deploy/compose.shared-proxy.yml --env-file .env up -d
#
# Variable names and placeholders only, in this file and in the copy you fill in: never commit
# a copy of this file with real values anywhere in this repository. This tree ships into a
# public snapshot (docs/pre-publication-checklist.md); a real password or key committed here
# would be published alongside a live, internet-facing instance that accepts it.

# Required before anything else (issue #203/#208). A compose project name is a global
# namespace on the Docker host, not scoped by directory: left unset here, this deployment would
# fall back to deploy/compose.yml's own name, which is deliberately one no real deployment
# should use. Pick one that is not that fallback and not the literal "opportun".
COMPOSE_PROJECT_NAME=opportun-demo

# Required, and deliberately has no working default: which published build deploy/compose.demo.yml
# runs. Always a specific tag from the publish step (docs/demo-deployment.md), e.g. sha-4a1b2c3,
# never `latest` -- paired with that file's pull_policy: always, a mutable tag would mean every
# `up -d` runs whatever was pushed most recently, with no way to say what that is and no way back
# to the one before it. To roll back, set this to the previous tag and run `up -d` again.
OPPORTUN_DEMO_IMAGE_TAG=

# Arms issue #280's seeded dataset and nightly reset (real AI, a low per-user budget cap, not
# mock output). Leave unset on every other deployment. 1 is this repo's existing convention for
# a single on/off flag (e.g. the test-only OPPORTUN_AI_MOCK, apps/server/src/testSupport).
OPPORTUN_DEMO=1

# The five fixed accounts issue #280's seeder creates and resets nightly, handed to visitors
# directly rather than created by self-registration (registration stays closed after the first
# account, as on every deployment). Generate each independently, e.g. `openssl rand -base64 18`,
# and keep a copy of these five wherever the invite list lives, not only here.
OPPORTUN_DEMO_ADMIN_PASSWORD=
OPPORTUN_DEMO_USER1_PASSWORD=
OPPORTUN_DEMO_USER2_PASSWORD=
OPPORTUN_DEMO_USER3_PASSWORD=
OPPORTUN_DEMO_USER4_PASSWORD=

# The AI provider key issue #280's seeder installs as a per-user secret on all five accounts.
# Every task's default policy is `anthropic` (console.anthropic.com), so there is exactly one
# provider to configure. Set a hard spend limit on this key in the provider's console BEFORE
# this instance is reachable: the nightly reset wipes the in-app per-user budget #280 also
# configures, so that budget bounds fairness between visitors, not actual spend (see
# docs/demo-deployment.md).
#
# Recommended: OPPORTUN_DEMO_AI_KEY_FILE, a path to a file holding the key, following the same
# `_FILE` convention as OPPORTUN_MASTER_KEY_FILE (issue #314). Two paths name the same file:
#
#   on the host:            deploy/data/demo-ai.key   (relative to the directory you run compose
#                                                      from, next to master.key, same permissions)
#   in this variable:       /data/demo-ai.key         (the container's view of that bind mount)
#
# The host path is deploy/data, not ./data, even though compose.yml says `./data`: compose
# resolves a compose file's relative paths against the directory of the FIRST -f file, which is
# deploy/, not against your shell's working directory. A key put at ./data/demo-ai.key never
# reaches the container. Verified with `docker compose config`, which renders that bind mount
# as <install>/deploy/data. An env var is readable by anything that can run
# `docker inspect` on the host and shows up in process listings and crash dumps; a file
# restricted to the operator's own user has neither exposure. Exactly one of the two is
# required (`docker compose up` refuses to start with neither set) -- set this one and leave
# OPPORTUN_DEMO_AI_KEY below blank.
OPPORTUN_DEMO_AI_KEY_FILE=

# The same key as a plain value, kept for convenience on a single-operator host (not wrong to
# use here -- OPPORTUN_DEMO_AI_KEY_FILE above is the narrower choice, not a claim that this one
# is unsafe). Set at most one of the two; the file wins if both are filled in.
OPPORTUN_DEMO_AI_KEY=

# A password pepper of this deployment's own (docs/install.md section 4), generated fresh and
# never reused from another deployment: openssl rand -hex 32
OPPORTUN_PEPPER=

# The domain visitors use: demo.opportun.app, confirmed by the owner on 2026-10-22 (#232). The
# marketing site keeps the apex (opportun.app); this subdomain is the demo instance only.
#
# OPPORTUN_BASE_URL is read by the application itself and is needed in every shape: it is the
# address the app puts in the links it generates.
OPPORTUN_BASE_URL=https://demo.opportun.app

# The four below are read ONLY by compose.yml's bundled `caddy` service. With
# compose.shared-proxy.yml layered on, that service never starts, so these are inert: verified
# with `docker compose config`, where only `opportun` is active and the only published port is
# 127.0.0.1:8080. In that shape the host's own Caddy issues the certificate for this name, not
# this one, and nothing here binds :80 or :443. Leave them out of a shared-proxy host's .env, or
# leave them in; either is harmless, but deleting them saves the next reader wondering.
#
# Without the shared-proxy override, the bundled Caddy IS the proxy, and these turn on automatic
# HTTPS for the domain. It issues its certificate once DNS points here, and only once: see "DNS
# before the first start" in docs/demo-deployment.md before running `up -d` with these set.
OPPORTUN_DOMAIN=demo.opportun.app
OPPORTUN_BIND_ADDRESS=0.0.0.0
OPPORTUN_HTTP_PORT=80
OPPORTUN_HTTPS_PORT=443

# Anything not listed above (log level, Postgres) follows .env.example and docs/install.md
# section 4 unchanged; this file only lists what the demo adds or must set differently.
